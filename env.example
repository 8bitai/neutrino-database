# neutrino-database — env template.
# Copy to .env and fill in for local dev. NEVER commit a real .env.
#
# Credentials (D-4): use placeholders here. Do NOT ship real or "well-known"
# passwords (postgres/root, postgres/postgres, …) in the template — they end up
# reused verbatim in real deployments.
#
# Least-privilege app role: the runtime should connect as a dedicated,
# non-superuser role that owns (or is granted only) the app schema — NOT the
# `postgres` superuser. Migrations may need broader rights; run `alembic upgrade`
# as a migration role and let the app connect as the restricted role, e.g.:
#
#   CREATE ROLE neutrino_app LOGIN PASSWORD '<password>';
#   GRANT CONNECT ON DATABASE neutrino_v2 TO neutrino_app;
#   GRANT USAGE ON SCHEMA public TO neutrino_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO neutrino_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public
#     GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO neutrino_app;
#
# TLS (D-4): for any non-localhost database, append `?sslmode=require` (or
# stricter: verify-full with a CA) so credentials + data are encrypted in
# transit. Localhost dev may omit it.

# Production runtime DB (the one alembic upgrades / app reads).
# Convention: dev DB is `neutrino_v2` to keep it out of any legacy
# personal databases on your machine.
#   local:      postgresql://<user>:<password>@localhost:5432/neutrino_v2
#   non-local:  postgresql://<user>:<password>@db.example.internal:5432/neutrino_v2?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/neutrino_v2

# Test DB (used only by pytest). MUST point at a different database
# than DATABASE_URL — the pytest conftest refuses to run otherwise.
# Bring it up once with: PGPASSWORD=<password> make setup-test-db
TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/neutrino_database_test_db

# OpenFGA authorization-model migrator (see neutrino_database/fga).
# Local dev talks to an auth-disabled OpenFGA over http; leave OPENFGA_API_TOKEN
# unset. In prod use an https URL and a preshared key (D-3):
#   OPENFGA_API_URL=https://openfga.example.internal:8080
#   OPENFGA_API_TOKEN=<preshared-key>
# Plain http to a non-localhost host is refused unless OPENFGA_ALLOW_INSECURE_HTTP=1.
OPENFGA_API_URL=http://localhost:8080
# OPENFGA_API_TOKEN=
