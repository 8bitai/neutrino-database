# neutrino-database — env template.
# Copy to .env and fill in for local dev.

# Production runtime DB (the one alembic upgrades / app reads).
# Convention: dev DB is `neutrino_v2` to keep it out of any legacy
# personal databases on your machine.
DATABASE_URL=postgresql://postgres:root@localhost:5432/neutrino_v2

# Test DB (used only by pytest). MUST point at a different database
# than DATABASE_URL — the pytest conftest refuses to run otherwise.
# Bring it up once with: PGPASSWORD=<pwd> make setup-test-db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/neutrino_database_test_db
